# Whitelist: only our Emberville mod, the libs it builds against, and the notes.
# Never commit reference/ (decompiled game code), game DLLs, or the Duckov practice mod.
/*
!/.gitignore
!/README.md
!/todo.md

!/spike/
/spike/*
!/spike/EmbervilleGhost/
!/spike/EmbervilleFavorites/
!/spike/BetterChests/
!/spike/BetterCombat/
!/spike/BetterLooting/
!/spike/BetterPetsAndSummons/
!/spike/BetterFishing/
!/spike/BetterNPCsAndQuests/
!/spike/BetterWeather/
!/spike/BetterNPCsAndQuests.Tests/
!/spike/EmbervilleGhost.Tests/
!/spike/package-all.ps1
!/spike/libs/

/spike/libs/*
!/spike/libs/OverlayDearImGui/
/spike/libs/OverlayDearImGui/*
!/spike/libs/OverlayDearImGui/ImGui.NET.dll
!/spike/libs/OverlayDearImGui/cimgui.dll
!/spike/libs/OverlayDearImGui/System.Runtime.CompilerServices.Unsafe.dll
!/spike/libs/Steamworks/
/spike/libs/Steamworks/*
!/spike/libs/Steamworks/com.rlabrecque.steamworks.net.dll
!/spike/libs/Steamworks/steam_api64.dll

bin/
obj/
*.user
.vs/
